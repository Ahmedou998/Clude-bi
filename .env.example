# --- Base de données ---------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/teranga_gp?schema=public"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Sessions (obligatoire en production) ------------------------------------
# Générer : openssl rand -base64 48
SESSION_SECRET="remplacez-moi-par-une-longue-valeur-aleatoire-de-32-caracteres-minimum"

# --- Codes de connexion (OTP) -------------------------------------------------
# Mode démonstration : le code s'affiche à l'écran, aucun SMS n'est envoyé.
# À METTRE À "false" (ou supprimer) avant tout usage réel.
ALLOW_DEMO_OTP="true"
# Relais HTTP vers votre fournisseur SMS / e-mail / WhatsApp (reçoit { channel, to, message } en POST JSON).
# OTP_WEBHOOK_URL=""
# OTP_WEBHOOK_TOKEN=""

# --- Paiement -----------------------------------------------------------------
# "simulation" : aucun argent ne circule (pilote). Un vrai prestataire doit être implémenté dans src/lib/payments.ts.
PAYMENT_PROVIDER="simulation"
